# ─────────────────────────────────────────────────────────────
#  SyafxAI — Environment Variables
#  Copy this file to `.env.local` and fill in the values.
#  Never commit `.env.local` or real credentials to git.
# ─────────────────────────────────────────────────────────────

# Supabase — public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server-only (NEVER expose to the browser).
# Used by admin/server routes that bypass RLS. Optional in dev.
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini — server-only (NEVER expose to the browser).
GEMINI_API_KEY=

# Gemini model configuration (optional — sensible defaults are used).
# Map the UI categories (fast / balanced / powerful) to model ids.
GEMINI_MODEL_FAST=gemini-2.5-flash-lite
GEMINI_MODEL_BALANCED=gemini-2.5-flash
GEMINI_MODEL_POWERFUL=gemini-2.5-pro
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# Image generation model (optional — leave empty to disable Image mode).
GEMINI_IMAGE_MODEL=

# Comma-separated list of admin emails (server-side admin gate).
ADMIN_EMAILS=

# App URL (used for share links / auth redirects). Optional in dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
#  Custom SMTP is configured in the Supabase Dashboard, NOT here:
#  Supabase Dashboard → Authentication → SMTP Settings
#  SMTP credentials must never live in the frontend or in git.
# ─────────────────────────────────────────────────────────────
